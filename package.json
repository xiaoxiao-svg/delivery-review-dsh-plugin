{
  "name": "delivery-review-plugin",
  "version": "2.0.0",
  "description": "DSH 专属双 Agent 交付协作插件：/dsh-delivery 命令 + 确定性状态机（JS 纯函数）+ 结构化审查结论（schema 校验）+ Web 活动面板（状态路由+浮层）+ 按任务规模自动分级。基于 DSH 原生能力（ask_user_question / toolFilter 只读隔离 / webServer 路由 / skills 注册），不使用 git notes、不由 LLM 手写状态。",
  "type": "module",
  "license": "MIT",
  "author": "xiaoxiao-svg",
  "homepage": "https://github.com/xiaoxiao-svg/delivery-review-dsh-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiao-svg/delivery-review-dsh-plugin.git"
  },
  "files": [
    "cordis.patch.yml",
    "src/",
    "web/",
    "workflow/",
    "roles/",
    "skills/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
